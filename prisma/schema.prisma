datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. WhatsApp API aur Gemini Bot ki Dynamic Settings
model SystemSettings {
  id                  String   @id @default("main_settings")
  phoneNumberId       String   @default("")
  businessAccountId   String   @default("")
  accessToken         String   @default("")
  verifyToken         String   @default("basekey_secret_token")
  isAiBotActive       Boolean  @default(false)
  geminiSystemPrompt  String   @default("You are a helpful AI assistant for BaseKey CRM.")
  updatedAt           DateTime @updatedAt
}

// 🔥 UPDATE: 2. Users (Admin aur Agents) Ka Data (NextAuth ke liye update kiya)
model User {
  id               String       @id @default(uuid())
  name             String?      // Optional: Google/GitHub se naam na aane par crash na ho
  email            String?      @unique // Optional: Kyunki GitHub/Twitter email hide kar sakte hain
  emailVerified    DateTime?    // 🔥 NAYA: NextAuth require karta hai email verification time
  image            String?      // 🔥 NAYA: Social Login se aayi hui Profile Photo ke liye
  passwordHash     String?      // Optional: Kyunki Google/Facebook login mein password nahi hota
  
  role             UserRole     @default(AGENT) // ADMIN ya AGENT
  status           AgentStatus  @default(OFFLINE) // ONLINE, BUSY, OFFLINE
  
  // Advanced Access Control & Tracking
  allowedPages     String[]     @default(["/chat", "/contacts"]) // Kaun se pages ka access hai
  primaryPage      String       @default("/chat") // Login karte hi kahan jayega
  currentActivity  String?      @default("Idle") // Live Tracking: "Chatting with Rahul"
  
  // Relations: Is agent ke paas kya-kya hai?
  assignedContacts Contact[]    
  sentMessages     Message[]    
  notes            InternalNote[] 
  quickReplies     QuickReply[] 

  // 🔥 NAYA: NextAuth Relations (Inhi ke zariye Account Linking hoti hai)
  accounts         Account[]
  sessions         Session[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ----------------------------------------------------------------------
// 🔥 NAYA NEXTAUTH TABLES (Google, Facebook, GitHub, X ko ek karne ke liye)
// ----------------------------------------------------------------------

// yeh table alag-alag social accounts (Google, FB) ko ek User se jodti hai
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ek provider se ek hi account link ho sakta hai
  @@unique([provider, providerAccountId])
}

// Session table background login maintain karne ke liye
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// OTP ya Magic Link ke liye (Future proofing)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------
// PURANE TABLES (Inme koi badlaav nahi kiya gaya)
// ----------------------------------------------------------------------

// 3. WhatsApp Contacts (Customers)
model Contact {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique 
  name             String?   
  email            String?   
  source           String    @default("manual") 
  unreadCount      Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  isSessionActive  Boolean   @default(true) 
  activeFlowNodeId String?   
  
  assignedToId     String?   
  assignedTo       User?     @relation(fields: [assignedToId], references: [id])
  isBotPaused      Boolean   @default(false) 
  
  messages         Message[]
  notes            InternalNote[] 
  
  createdAt        DateTime  @default(now())
}

// 4. Messages Model (Chat & Analytics)
model Message {
  id          String        @id 
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  senderId    String?       
  sender      User?         @relation(fields: [senderId], references: [id])

  body        String        @default("") 
  type        MessageType   @default(TEXT) 
  direction   MessageDirection
  status      MessageStatus @default(SENT) 
  mediaUrl    String?       
  source      MessageSource @default(CHAT) 
  
  timestamp   DateTime      @default(now())
}

// 5. Internal Private Notes
model InternalNote {
  id          String   @id @default(uuid())
  content     String   
  
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  authorId    String   
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
}

// 6. Quick Replies (Canned Responses)
model QuickReply {
  id          String   @id @default(uuid())
  shortcut    String   @unique 
  message     String   
  
  authorId    String?  
  author      User?    @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
}

// 7. Chatbot Flow
model ChatFlow {
  id        String   @id @default(uuid())
  name      String   @default("Default Flow")
  isActive  Boolean  @default(true)
  nodes     Json     
  edges     Json     
  updatedAt DateTime @updatedAt
}

// 8. WhatsApp Templates
model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  language    String   @default("en_US")
  category    String   @default("MARKETING")
  components  Json     
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 9. API Keys Management
model ApiKey {
  id          String    @id @default(uuid())
  name        String    
  token       String    @unique 
  expiresAt   DateTime? 
  isRevoked   Boolean   @default(false) 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 10. Campaigns Model (Asli data save karne ke liye)
model Campaign {
  id          String   @id @default(uuid())
  name        String
  template    String
  status      String   @default("running") // completed, running, scheduled, draft
  audience    Int      @default(0)
  sent        Int      @default(0)
  delivered   Int      @default(0)
  read        Int      @default(0)
  
  authorId    String?  
  author      User?    @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- ENUMS FOR STRICT DATA TYPING ---

enum UserRole {
  ADMIN
  AGENT
}

enum AgentStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  TEMPLATE
  LOCATION
  STICKER
}

enum MessageSource {
  CHAT      
  FLOW      
  API       
  CAMPAIGN  
}

enum MessageDirection {
  INBOUND  
  OUTBOUND 
}

enum MessageStatus {
  SENT      
  DELIVERED 
  READ      
}
