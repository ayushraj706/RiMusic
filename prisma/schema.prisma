datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. WhatsApp API aur Gemini Bot ki Dynamic Settings
model SystemSettings {
  id                  String   @id @default("main_settings")
  phoneNumberId       String   @default("")
  businessAccountId   String   @default("")
  accessToken         String   @default("")
  verifyToken         String   @default("basekey_secret_token")
  isAiBotActive       Boolean  @default(false)
  geminiSystemPrompt  String   @default("You are a helpful AI assistant for BaseKey CRM.")
  updatedAt           DateTime @updatedAt
}

// 🔥 UPDATE: 2. Users (Admin aur Agents) Ka Data - Enhanced for Multi-Auth & Agents
model User {
  id               String       @id @default(uuid())
  name             String?      // Optional: Google/GitHub se naam na aane par crash na ho
  email            String?      @unique // Main linking point for Social & Custom Login
  emailVerified    DateTime?    
  image            String?      
  passwordHash     String?      // Optional: Social login walo ka null hoga, email walo ka hashed hoga
  
  role             UserRole     @default(AGENT) 
  status           AgentStatus  @default(OFFLINE) 
  
  // Advanced Access Control & Tracking for Agents
  allowedPages     String[]     @default(["/chat", "/contacts"]) 
  primaryPage      String       @default("/chat") 
  currentActivity  String?      @default("Idle") 
  lastSeen         DateTime?    // 🔥 NAYA: Agent kab last online tha track karne ke liye
  department       String?      // 🔥 NAYA: Agent kis department ka hai (e.g., Sales, Support)
  
  // Relations: Is agent ke paas kya-kya hai?
  assignedContacts Contact[]    
  sentMessages     Message[]    
  notes            InternalNote[] 
  quickReplies     QuickReply[] 
  campaigns        Campaign[]

  // NextAuth Relations (Inhi ke zariye Account Linking hoti hai)
  accounts         Account[]
  sessions         Session[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ----------------------------------------------------------------------
// 🔥 NAYA: AUTHENTICATION TABLES (OTP & Password Reset)
// ----------------------------------------------------------------------

// Email OTP (6-digit code) save karne ke liye
model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime // Code logic me isko 'now() + 5 minutes' set karna hoga
  createdAt DateTime @default(now())

  @@unique([email, code]) // Ek email ka specific code verify karne ke liye fast query
  @@index([email])
}

// Password Reset karne ke link token ke liye
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime // Code logic me isko 'now() + 1 hour' ya 15 mins set kar sakte ho
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([email])
}

// ----------------------------------------------------------------------
// NEXTAUTH TABLES (Google, Facebook, GitHub, X ko ek karne ke liye)
// ----------------------------------------------------------------------

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth ka default Magic Link Token table
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------
// PURANE TABLES (Inme koi badlaav nahi kiya gaya hai)
// ----------------------------------------------------------------------

// 3. WhatsApp Contacts (Customers)
model Contact {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique 
  name             String?   
  email            String?   
  source           String    @default("manual") 
  unreadCount      Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  isSessionActive  Boolean   @default(true) 
  activeFlowNodeId String?   
  
  assignedToId     String?   
  assignedTo       User?     @relation(fields: [assignedToId], references: [id])
  isBotPaused      Boolean   @default(false) 
  
  messages         Message[]
  notes            InternalNote[] 
  
  createdAt        DateTime  @default(now())
}

// 4. Messages Model (Chat & Analytics)
model Message {
  id          String        @id 
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  senderId    String?       
  sender      User?         @relation(fields: [senderId], references: [id])

  body        String        @default("") 
  type        MessageType   @default(TEXT) 
  direction   MessageDirection
  status      MessageStatus @default(SENT) 
  mediaUrl    String?       
  source      MessageSource @default(CHAT) 
  
  timestamp   DateTime      @default(now())
}

// 5. Internal Private Notes
model InternalNote {
  id          String   @id @default(uuid())
  content     String   
  
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  authorId    String   
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
}

// 6. Quick Replies (Canned Responses)
model QuickReply {
  id          String   @id @default(uuid())
  shortcut    String   @unique 
  message     String   
  
  authorId    String?  
  author      User?    @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
}

// 7. Chatbot Flow
model ChatFlow {
  id        String   @id @default(uuid())
  name      String   @default("Default Flow")
  isActive  Boolean  @default(true)
  nodes     Json     
  edges     Json     
  updatedAt DateTime @updatedAt
}

// 8. WhatsApp Templates
model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  language    String   @default("en_US")
  category    String   @default("MARKETING")
  components  Json     
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 9. API Keys Management
model ApiKey {
  id          String    @id @default(uuid())
  name        String    
  token       String    @unique 
  expiresAt   DateTime? 
  isRevoked   Boolean   @default(false) 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 10. Campaigns Model (WhatsApp Bulk Broadcasts ke liye)
model Campaign {
  id          String   @id @default(uuid())
  name        String
  template    String
  status      String   @default("running") // completed, running, scheduled, draft
  audience    Int      @default(0)
  sent        Int      @default(0)
  delivered   Int      @default(0)
  read        Int      @default(0)
  
  authorId    String?  
  author      User?    @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- ENUMS FOR STRICT DATA TYPING ---

enum UserRole {
  ADMIN
  AGENT
}

enum AgentStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  TEMPLATE
  LOCATION
  STICKER
}

enum MessageSource {
  CHAT      
  FLOW      
  API       
  CAMPAIGN  
}

enum MessageDirection {
  INBOUND  
  OUTBOUND 
}

enum MessageStatus {
  SENT      
  DELIVERED 
  READ      
}
