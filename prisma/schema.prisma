datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. WhatsApp API aur Gemini Bot ki Dynamic Settings
model SystemSettings {
  id                  String   @id @default("main_settings")
  phoneNumberId       String   @default("")
  businessAccountId   String   @default("")
  accessToken         String   @default("")
  verifyToken         String   @default("basekey_secret_token")
  isAiBotActive       Boolean  @default(false)
  geminiSystemPrompt  String   @default("You are a helpful AI assistant for BaseKey CRM.")
  updatedAt           DateTime @updatedAt
}

// 2. WhatsApp Contacts (Chat Sidebar)
model Contact {
  id               String    @id @default(uuid())
  phoneNumber      String    @unique 
  name             String?   
  email            String?   
  source           String    @default("manual") 
  unreadCount      Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  isSessionActive  Boolean   @default(true) 
  activeFlowNodeId String?   
  messages         Message[]
  createdAt        DateTime  @default(now())
}

// 3. Messages Model (Analytics ke liye Upgrade kiya gaya)
model Message {
  id          String        @id 
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body        String        @default("") 
  type        MessageType   @default(TEXT) 
  direction   MessageDirection
  status      MessageStatus @default(SENT) 
  mediaUrl    String?       
  
  // NAYA: Analytics track karne ke liye (Message kahan se gaya?)
  source      MessageSource @default(CHAT) 
  
  timestamp   DateTime      @default(now())
}

// 4. Chatbot Flow
model ChatFlow {
  id        String   @id @default(uuid())
  name      String   @default("Default Flow")
  isActive  Boolean  @default(true)
  nodes     Json     
  edges     Json     
  updatedAt DateTime @updatedAt
}

// 5. NAYA: WhatsApp Templates (Media + Text + Buttons)
model Template {
  id          String   @id @default(uuid())
  name        String   @unique
  language    String   @default("en_US")
  category    String   @default("MARKETING")
  components  Json     
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 6. NAYA: API Keys Management (Expiry + Revoke + Template tracking)
model ApiKey {
  id          String    @id @default(uuid())
  name        String    // Linked Template ka naam
  token       String    @unique 
  expiresAt   DateTime? // Expiry date
  isRevoked   Boolean   @default(false) // Emergency Kill Switch
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// --- ENUMS FOR STRICT DATA TYPING ---

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  TEMPLATE // NAYA: Template messages track karne ke liye
  LOCATION // NAYA: Location track karne ke liye
  STICKER  // NAYA: Stickers track karne ke liye
}

// NAYA: Analytics Source Tracking (Dashboard ke PDFs ke liye)
enum MessageSource {
  CHAT      // Chat dashboard se gaya
  FLOW      // Flow Builder/Bot se gaya
  API       // External Trigger API se gaya
  CAMPAIGN  // Bulk Campaign se gaya
}

enum MessageDirection {
  INBOUND  
  OUTBOUND 
}

enum MessageStatus {
  SENT      
  DELIVERED 
  READ      
}
